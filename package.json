{
  "name": "mail-triage-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:types && node scripts/build-compat.mjs && npm run build:viewer && npm run build:markdown && npm run build:ui",
    "build:ui": "vite build --config packages/ui/ui/vite.config.ts",
    "verify:ui": "node scripts/verify-react-suite.mjs",
    "build:markdown": "node scripts/build-markdown.mjs",
    "build:viewer": "vite build --config packages/ui/viewer/vite.config.ts",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "typecheck": "npm run build:types -- --noEmit && npm run build:types -- -p packages/ui/viewer/tsconfig.json && npm run build:types -- -p packages/ui/ui/tsconfig.json",
    "lint": "eslint packages/ui/ui packages/ui/viewer --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"packages/ui/ui/**/*.{ts,tsx,css,json,html}\" \"packages/ui/viewer/**/*.{js,ts,tsx,css,json,html}\" eslint.config.mjs .prettierrc.json",
    "format:check": "prettier --check \"packages/ui/ui/**/*.{ts,tsx,css,json,html}\" \"packages/ui/viewer/**/*.{js,ts,tsx,css,json,html}\" eslint.config.mjs .prettierrc.json",
    "test": "tsx --test --test-concurrency=4 test/*.test.ts",
    "diagnose": "tsx src/diagnose.ts",
    "build:types": "node node_modules/@typescript/native/bin/tsc"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@extend-ai/react-docx": "0.9.2",
    "@extend-ai/react-pptx": "0.2.1",
    "@extend-ai/react-xlsx": "0.16.4",
    "@hello-pangea/dnd": "18.0.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@mui/material": "9.4.0",
    "@tanstack/react-query": "5.103.1",
    "dompurify": "3.4.15",
    "express": "5.2.1",
    "hash-wasm": "4.12.0",
    "jose": "6.2.12",
    "marked": "18.0.13",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "playwright-core": "^1.63.0",
    "prettier": "3.9.8",
    "tsx": "^4.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript-eslint": "8.70.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
