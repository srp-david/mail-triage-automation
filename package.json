{
  "name": "mail-triage-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/build-compat.mjs && npm run build:viewer && npm run build:markdown && npm run build:ui",
    "build:ui": "vite build --config packages/ui/ui/vite.config.ts",
    "verify:ui": "node scripts/verify-react-suite.mjs",
    "build:markdown": "node scripts/build-markdown.mjs",
    "build:viewer": "vite build --config packages/ui/viewer/vite.config.ts",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "check": "tsc --noEmit && tsc -p packages/ui/viewer/tsconfig.json && tsc -p packages/ui/ui/tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "diagnose": "tsx src/diagnose.ts"
  },
  "dependencies": {
    "@extend-ai/react-docx": "0.9.2",
    "@extend-ai/react-pptx": "0.2.1",
    "@extend-ai/react-xlsx": "0.16.4",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@tanstack/react-query": "5.103.1",
    "dompurify": "3.4.15",
    "express": "5.2.1",
    "jose": "6.2.12",
    "marked": "18.0.13",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "^1.63.0",
    "tsx": "^4.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
