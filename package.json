{
  "name": "mail-triage-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:types && node scripts/build-compat.mjs && npm run build:viewer && npm run build:markdown && npm run build:ui",
    "build:ui": "vite build --config packages/ui/ui/vite.config.ts",
    "verify:ui": "node scripts/verify-react-suite.mjs",
    "build:markdown": "node scripts/build-markdown.mjs",
    "build:viewer": "vite build --config packages/ui/viewer/vite.config.ts",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "typecheck": "npm run build:types -- --noEmit && npm run build:types -- -p packages/ui/viewer/tsconfig.json && npm run build:types -- -p packages/ui/ui/tsconfig.json",
    "lint": "eslint packages/ui/ui packages/ui/viewer website/*.js --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"packages/ui/ui/**/*.{ts,tsx,css,json,html}\" \"packages/ui/viewer/**/*.{js,ts,tsx,css,json,html}\" eslint.config.mjs .prettierrc.json website/*.js website/package.json website/src/css/custom.css playwright.docs.config.ts test/docs-e2e/*.ts",
    "format:check": "prettier --check \"packages/ui/ui/**/*.{ts,tsx,css,json,html}\" \"packages/ui/viewer/**/*.{js,ts,tsx,css,json,html}\" eslint.config.mjs .prettierrc.json website/*.js website/package.json website/src/css/custom.css playwright.docs.config.ts test/docs-e2e/*.ts",
    "test": "vitest run --project unit --project ui",
    "diagnose": "tsx src/diagnose.ts",
    "build:types": "node node_modules/@typescript/native/bin/tsc",
    "test:watch": "vitest --project unit --project ui",
    "test:integration": "node scripts/test-isolated.mjs",
    "test:all": "node scripts/test-isolated.mjs --all",
    "test:coverage": "vitest run --project unit --project ui --coverage",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report .runtime/playwright-report",
    "test:external": "node scripts/test-isolated.mjs --external",
    "docs:install": "npm --prefix website ci",
    "docs:dev": "npm --prefix website start --",
    "docs:build": "npm --prefix website run build --",
    "docs:serve": "npm --prefix website run serve --",
    "docs:test": "playwright test --config playwright.docs.config.ts"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@extend-ai/react-docx": "0.9.2",
    "@extend-ai/react-pptx": "0.2.1",
    "@extend-ai/react-xlsx": "0.16.4",
    "@hello-pangea/dnd": "18.0.1",
    "@hookform/resolvers": "5.9.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@mui/material": "9.4.0",
    "@tanstack/react-query": "5.103.1",
    "dompurify": "3.4.15",
    "express": "5.2.1",
    "hash-wasm": "4.12.0",
    "jose": "6.2.12",
    "marked": "18.0.13",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "playwright-core": "^1.63.0",
    "prettier": "3.9.8",
    "tsx": "^4.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
