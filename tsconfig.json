{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "outDir": "dist",
    "rootDir": ".",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "apps/**/*.ts",
    "packages/contracts/**/*.ts",
    "packages/history-client/**/*.ts",
    "packages/runner/**/*.ts",
    "packages/agent-adapters/**/*.ts"
  ]
}
